# Copy this file to .env on the server and replace every placeholder.

# Use a dedicated database user in production, not root.
DATABASE_URL="mysql://admin:siame1234@127.0.0.1:3306/service_management_db"

# Required in production. Use a long random value and keep it secret.
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# Use false only when testing through plain HTTP such as http://10.10.1.8:3000.
# Use true when the site is behind HTTPS in production.
AUTH_COOKIE_SECURE="true"

# Hidden owner account bootstrap. Change these after first login in production.
OWNER_USERNAME="byteza007x"
OWNER_PASSWORD="CHANGE_ME_OWNER_PASSWORD"

# Optional but recommended for multi-instance deployments.
# Generate a stable base64 AES key and keep it the same across instances/builds.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# Optional deployment identifier for rolling deployments.
# DEPLOYMENT_VERSION="2026-07-08-001"

# Optional readiness check URL used by npm.cmd run check:prod.
# CHECK_APP_URL="http://127.0.0.1:3000/api/health"
